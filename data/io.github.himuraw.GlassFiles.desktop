[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse folders and files
Exec=glass-files %U
Icon=system-file-manager
Terminal=false
StartupNotify=true
Categories=GTK;GNOME;Utility;Core;FileManager;
MimeType=inode/directory;
Keywords=folder;files;explorer;manager;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=glass-files
